{
	"compass_panel": {
		"type": "panel",
		"size": [22.5, 20],
		"anchor_to": "center",
		"anchor_from": "center",
		"controls": [
			{
				"compass_overlay": {
					"type": "custom",
					"renderer": "inventory_item_renderer",
					"size": [18.5, 18.5],
					"offset": [0, -1.5],
					"anchor_to": "center",
					"anchor_from": "center",
					"property_bag": { "#item_id_aux": 22609920 }
				}
			}
		]
	},

	"clock_panel": {
		"type": "panel",
		"size": [22.5, 20],
		"anchor_to": "center",
		"anchor_from": "center",
		"controls": [
			{
				"clock_overlay": {
					"type": "custom",
					"renderer": "inventory_item_renderer",
					"size": [18.5, 18.5],
					"offset": [0, -1.5],
					"anchor_to": "center",
					"anchor_from": "center",
					"property_bag": { "#item_id_aux": 22740992 }
				}
			}
		]
	},

	"kado_hud_base": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [180, 20],
		"anchor_to": "top_middle",
		"anchor_from": "top_middle",
		"controls": [
			{ "compass_panel@hud.compass_panel": {} },
			{ "clock_panel@hud.clock_panel": {} }
		]
	},

	"kado_hud": {
		"type": "panel",
		"offset": "$offset",
		"controls": [{ "kado_hud_base@hud.kado_hud_base": {} }],
		"variables": [
			{
				"requires": "($mouse or $game_pad)",
				"$offset": [0, 4]
			},
			{
				"requires": "$touch",
				"$offset": [0, 20]
			}
		],
		"bindings": [
			{
				"binding_name": "(not #bar_visible)",
				"binding_type": "collection",
				"binding_collection_name": "boss_bars",
				"binding_name_override": "#visible"
			}
		]
	},

	"hotbar_numbers": {
