	"hud_title_text/title_frame": {
		"bindings": [
			{ "binding_name": "#hud_title_text_string" },
			{
				"binding_type": "view",
				"source_property_name": "((#hud_title_text_string - 'kado:') = #hud_title_text_string)",
				"target_property_name": "#visible"
			}
		]
	},

	"hud_title_text/subtitle_frame": {
		"bindings": [
			{ "binding_name": "#hud_subtitle_text_string" },
			{
				"binding_type": "view",
				"source_property_name": "((#hud_subtitle_text_string - 'kado:') = #hud_subtitle_text_string)",
				"target_property_name": "#visible"
			}
		]
	},

	"boss_health_panel": {
		"type": "panel",
		"size": [182, 20],
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"$progress_bar_collection": "boss_bars",
		"controls": [
			{
				"boss_name@boss_name_panel": {}
			},
			{
				"progress_bar_for_collections@common.progress_bar_for_collections": {
					"offset": [0, 10]
				}
			},
			{
				"kado_hud_base@hud.kado_hud_base": {
					"offset": [0, 17.5]
				}
			}
		],
		"bindings": [
			{
				"binding_name": "#bar_visible",
				"binding_type": "collection",
				"binding_collection_name": "boss_bars",
				"binding_name_override": "#visible"
			}
		]
	},

	"root_panel": {
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_front",
				"value": [
					{
						"kado_hud@hud.kado_hud": {}
					},
					{
						"hotbar_numbers@hud.hotbar_numbers": {}
					},
					{
						"kpadv_content@hud_layout_kpadv.kpadv_content": {}
					},
					{
						"kpadv_title_data_binding@hud_kpadv.title_text_data": {}
					},
					{
						"kpadv_subtitle_data_binding@hud_kpadv.subtitle_text_data": {}
					}
				]
			}
